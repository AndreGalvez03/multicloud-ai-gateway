# Local fixtures only. Copy to .env if you want to override docker-compose defaults.
# These values are not cloud credentials. Real deployments inject secrets at runtime.

AIGW_DATABASE_URL=postgresql+psycopg://aigw_local:aigw_local@127.0.0.1:5432/aigw
AIGW_LITELLM_BASE_URL=http://127.0.0.1:4000
AIGW_LITELLM_API_KEY=local-dev-master-key
AIGW_ADMIN_TOKEN=local-admin-token
AIGW_ENV=local
AIGW_ALLOW_OPEN_READS=true
AIGW_SEED_DEMO_DATA=true

LITELLM_MASTER_KEY=local-dev-master-key
MOCK_PROVIDER_KEY=mock-provider-key
GRAFANA_ADMIN_PASSWORD=local-grafana-admin

# How a real environment gets secrets (never commit the values):
# - Postgres URL: AWS Secrets Manager, projected by External Secrets. See deploy/examples/external-secret.yaml.
# - Bedrock: no API key. The gateway ServiceAccount uses IRSA. See infra/terraform/aws/modules/bedrock.
# - Vertex AI: Workload Identity on the gateway service account. See infra/terraform/gcp.
# - Azure AI Foundry: managed identity, local auth disabled. See infra/terraform/azure.
# - A third-party API key: Secrets Manager, not a static key in the task definition or this file.
