server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Open reads are a local setting. Do not inject the admin token here.
    location = /api/v1/dashboard/summary {
        proxy_pass http://platform:8080/v1/dashboard/summary;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
