server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://platform:8080/;
        proxy_set_header Host $host;
        proxy_set_header Authorization "Bearer ${AIGW_ADMIN_TOKEN}";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
